PORT=5000
NODE_ENV=production
# Frontend URL for CORS (Render environment variable):
CLIENT_URL=https://doc-clone-using-mern.vercel.app

# Database & Authentication (To be added once MongoDB Atlas is set up):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

